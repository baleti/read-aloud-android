<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- package/applicationId now comes from build.gradle's namespace +
         defaultConfig.applicationId (AGP 8+ convention) - having it here
         too would conflict. Introducing Gradle at all (2026-09-13) was
         forced by play-services-mlkit-text-recognition's real dependency
         graph (Firebase + AndroidX, 15-25+ transitive AARs) - hand-
         resolving that in the old aapt2/kotlinc/d8 pipeline (build.sh,
         kept only for reference) was a real, substantial risk of a
         subtly broken build, not just more typing. See docs/design.md. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Read Aloud" android:allowBackup="false" android:usesCleartextTraffic="true" android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Read Aloud">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reddit's second entry point (see RedditShareActivity's own
             doc): its accessibility tree is too empty to ever read a
             post's URL off the screen, so the generic corner-swipe
             trigger below has no way to know what to fetch. Share a
             Reddit post/comment, pick "Read Aloud" from the share sheet
             instead. NoDisplay theme - it shows a Toast and finishes
             immediately, no visible screen of its own. -->
        <activity
            android:name=".RedditShareActivity"
            android:exported="true"
            android:label="Read Aloud"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The trigger: dictate-android's AssistActivity (the long-press-
             power action menu) sends this broadcast when "Read Aloud" is
             tapped there. Exported and permission-less deliberately - it
             carries no data (the receiver reads whatever app is currently
             foregrounded itself via the accessibility service, it isn't
             told), so there's nothing to protect by locking it down, and
             locking it down would mean coordinating a shared signing key
             or permission declaration between two independently-built
             apps for no real benefit. Any app on the device could send
             this broadcast and trigger a read of the current screen -
             equivalent in effect to a very slow, screen-reader-shaped
             version of the volume/brightness broadcasts every app can
             already send. -->
        <receiver
            android:name=".TriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.local.readaloud.action.READ_CURRENT_SCREEN" />
            </intent-filter>
        </receiver>

        <service
            android:name=".TtsPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- Accessibility service: the reader. Needs canPerformGestures
             (scroll/tap "N more replies" in apps like Reddit whose real
             content isn't all present as addressable nodes) and
             canRequestFilterKeyEvents (volume-key skip controls while
             reading) in addition to the base canRetrieveWindowContent -
             deliberately NOT canRequestTouchExplorationMode, which is
             what would hijack normal tap behavior system-wide the way
             enabling TalkBack does; this service stays completely inert
             until TriggerReceiver calls its own startReading(). Must be
             enabled by hand in Settings, then
             Accessibility - no way around that, same as any accessibility
             service on any Android device (dictate-android's own
             DictateAccessibilityService has the identical requirement). -->
        <service
            android:name=".ReadAloudAccessibilityService"
            android:label="Read Aloud"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
